# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session & Auth (required — change these in production!)
SESSION_SECRET=your-session-secret-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production

# Admin credentials (optional — defaults shown)
ADMIN_EMAIL=admin@selfwellness.com
ADMIN_PASSWORD=selfwellness786#

# Google Cloud Storage (optional — for image uploads)
GCS_BUCKET_NAME=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# OpenAI (optional — for AI product import & mockup generation)
OPENAI_API_KEY=sk-...

# Server
PORT=3001
NODE_ENV=production
