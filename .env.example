# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/selfwellness

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
ADMIN_EMAIL=admin@selfwellness.com
ADMIN_PASSWORD=your-strong-admin-password

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
# Comma-separated list of allowed frontend origins (leave empty to allow all)
ALLOWED_ORIGINS=https://yourdomain.pages.dev,https://selfwellness.com

# ─── PAYMENTS (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret

# ─── EMAIL (SMTP / Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@selfwellness.com

# ─── MEDIA (Cloudinary) ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── FRONTEND (set in Cloudflare Pages environment variables) ─────────────────
# VITE_API_URL=https://your-backend.railway.app
